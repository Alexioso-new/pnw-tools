rules_version = '2';

// ============================================================
// HOSANA YOUTH TOOLS — Cloud Storage Rules
// Versi: v80 / label v5.8  ·  9 Agustus 2026
//
// Hasil audit kode v80: youTh Views TIDAK memakai Cloud Storage sama sekali.
// Media latar belakang (gambar/video) disimpan lokal di IndexedDB "pnwYvMedia"
// dengan id "idb:<id>", jadi tidak perlu aturan baru untuk youTh Views.
//
// Yang memakai Storage hanya:
//   recordings/...  -> js/recorder.js  (rekaman latihan)
//   guide/...       -> js/guide.js     (lampiran Buku Panduan)
//
// Perubahan dari versi sesi sebelumnya: hanya penambahan batas ukuran &
// tipe berkas + penolakan eksplisit untuk path lain. Izin dasarnya sama,
// jadi tidak ada regresi.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Rekaman latihan. Boleh dibaca siapa saja (dipakai pemutar di aplikasi),
    // hanya pengguna yang sudah login yang boleh mengunggah.
    match /recordings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 80 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null;
    }

    // Lampiran Buku Panduan. Hanya pemilik yang boleh mengubah.
    match /guide/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1'
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null
        && request.auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1';
    }

    // Semua path lain ditolak (default-deny yang ditulis eksplisit).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
