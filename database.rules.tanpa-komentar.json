{
  "rules": {
    ".read": false,
    ".write": false,
    "pujianYouth": {
      ".read": "auth != null",
      "admins": {
        ".write": "auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1'"
      },
      "adminRequests": {
        ".read": "auth != null && (auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1' || root.child('pujianYouth/admins').child(auth.uid).exists())",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && (auth.uid == $uid || auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1')",
          ".validate": "newData.hasChildren(['email','nama','status'])"
        }
      },
      "songs": {
        ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
      },
      "songBank": {
        ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
      },
      "schedule4": {
        ".write": "auth != null && root.child('pujianYouth/admins').child(auth.uid).exists()"
      },
      "notes": {
        ".write": "auth != null && root.child('pujianYouth/admins').child(auth.uid).exists()"
      },
      "noteOverrides": {
        ".write": "auth != null && root.child('pujianYouth/admins').child(auth.uid).exists()"
      },
      "config": {
        ".write": "auth != null && root.child('pujianYouth/admins').child(auth.uid).exists()"
      },
      "noteLikes": {
        ".write": "auth != null"
      },
      "live": {
        ".write": "auth != null",
        ".validate": "newData.hasChild('active')"
      },
      "youthviews": {
        ".read": "auth != null",
        "live": {
          ".write": "auth != null && (auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1' || root.child('pujianYouth/admins').child(auth.uid).exists())",
          ".validate": "newData.hasChild('active')"
        }
      },
      "projector": {
        ".read": "auth != null",
        "plan": {
          ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
        },
        "settings": {
          ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
        }
      },
      "saran": {
        ".write": "auth != null"
      },
      "recordings": {
        ".read": true,
        ".write": "auth != null"
      },
      "guide": {
        ".read": true,
        ".write": "auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1'"
      }
    },
    "logs": {
      ".read": "auth != null && root.child('pujianYouth/admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('pujianYouth/admins').child(auth.uid).exists()",
      "$logId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['at','type'])"
      }
    }
  }
}
