{
  "rules": {
    "pujianYouth": {
      ".read": "auth != null",
      "songs": {
        ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
      },
      "songBank": {
        ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
      },
      "admins": {
        ".write": "auth != null && auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1'"
      },
      "adminRequests": {
        ".write": "auth != null"
      },
      "config": {
        ".write": "auth != null && (auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1' || root.child('pujianYouth/admins').child(auth.uid).exists())"
      },
      "live": {
        ".write": "auth != null",
        ".validate": "newData.hasChild('active')"
      },
      "youthviews": {
        ".read": "auth != null",
        "live": {
          ".read": true,
          ".write": "auth != null && (auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1' || root.child('pujianYouth/admins').child(auth.uid).exists())",
          ".validate": "newData.hasChild('active')"
        },
        "heartbeat": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['ts', 'sig']) && newData.child('ts').isNumber() && newData.child('sig').isString() && newData.child('sig').val().length < 200"
        }
      },
      "projector": {
        ".read": "auth != null",
        "plan": {
          ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
        },
        "settings": {
          ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
        },
        "timelines": {
          ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
        }
      },
      "notes": {
        ".write": "auth != null"
      },
      "noteOverrides": {
        ".write": "auth != null && (auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1' || root.child('pujianYouth/admins').child(auth.uid).exists())"
      },
      "noteLikes": {
        ".write": "auth != null"
      },
      "schedule4": {
        ".write": "auth != null && (root.child('pujianYouth/admins').child(auth.uid).exists() || root.child('pujianYouth/config/locked').val() !== true)"
      },
      "saran": {
        ".write": "auth != null"
      },
      "recordings": {
        ".read": true,
        ".write": "auth != null"
      },
      "guide": {
        ".read": true,
        ".write": "auth != null && auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1'"
      }
    },
    "logs": {
      ".read": "auth != null && (auth.uid == 'l9U1ktYog2X3vSA81JdsjHln5qu1' || root.child('pujianYouth/admins').child(auth.uid).exists())",
      ".write": "auth != null"
    }
  }
}
